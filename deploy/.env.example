# .env.example — OpenArtifact Docker Configuration
#
# Copy to deploy/.env (next to docker-compose.yml) and adjust the values.
# All variables use the OPENARTIFACT_ prefix.

# ── Server ──────────────────────────────────────────────────────────
OPENARTIFACT_HOST=0.0.0.0
OPENARTIFACT_PORT=2909
OPENARTIFACT_DEBUG=false

# ── Database ────────────────────────────────────────────────────────
# Database filename (default: openartifact.db)
OPENARTIFACT_DATABASE_FILENAME=openartifact.db
# Data directory (default: /data — mounted as Docker volume)
OPENARTIFACT_DATA_DIR=/data

# ── Security ────────────────────────────────────────────────────────
# Required as soon as OPENARTIFACT_API_TOKEN is set: the application refuses to start with an empty or
# default key. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
OPENARTIFACT_SECRET_KEY=

# ── Logging ─────────────────────────────────────────────────────────
OPENARTIFACT_LOG_LEVEL=INFO

# Access token. With a token the whole application asks for it (sign-in page for browsers, bearer
# header for scripts, /api/v1 and /mcp). Empty: the application is open and /api/v1 and /mcp are off.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENARTIFACT_API_TOKEN=

# ── Docker Compose only (read for the compose file, not by the application) ──
# Address and port the container is published on. 127.0.0.1 keeps it local; 0.0.0.0 opens it to the network.
OPENARTIFACT_BIND=127.0.0.1
OPENARTIFACT_PUBLISHED_PORT=2909
# Image tag when you pull a released image instead of building (docker compose pull).
OPENARTIFACT_TAG=latest
