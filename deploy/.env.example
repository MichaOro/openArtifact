# .env.example — OpenArtifact Docker Configuration
#
# Copy to deploy/.env (next to docker-compose.yml) and adjust the values.
# All variables use the OPENARTIFACT_ prefix.

# ── Server ──────────────────────────────────────────────────────────
OPENARTIFACT_HOST=0.0.0.0
OPENARTIFACT_PORT=2909
OPENARTIFACT_DEBUG=false

# ── Database ────────────────────────────────────────────────────────
# Database filename (default: openartifact.db)
OPENARTIFACT_DATABASE_FILENAME=openartifact.db
# Data directory (default: /data — mounted as Docker volume)
OPENARTIFACT_DATA_DIR=/data

# ── Security ────────────────────────────────────────────────────────
# Required as soon as OPENARTIFACT_API_TOKEN is set: the application refuses to start with an empty or
# default key. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
OPENARTIFACT_SECRET_KEY=

# ── Logging ─────────────────────────────────────────────────────────
OPENARTIFACT_LOG_LEVEL=INFO

# Access token, at least 32 characters (the application refuses to start with a shorter one). With a
# token the whole application asks for it (sign-in page for browsers, bearer header for scripts,
# /api/v1 and /mcp). Empty: the pages and the browser API are open to everyone who can reach the port
# and /api/v1 and /mcp are off.
# Generate one with: openssl rand -hex 32
OPENARTIFACT_API_TOKEN=

# ── Optional security and limits (defaults shown; see docs/guides/configuration.md) ──
# Host names the application answers to, comma separated (example.com, *.example.org). Empty: no check.
# OPENARTIFACT_ALLOWED_HOSTS=
# auto: the session cookie is Secure when the request is https; true: always (right behind a TLS proxy); false: never.
# OPENARTIFACT_COOKIE_SECURE=auto
# Largest request body in bytes.
# OPENARTIFACT_MAX_REQUEST_BYTES=1048576
# Active runs at the same time (a further start gets 429) and open live-update streams (a further one gets 503).
# OPENARTIFACT_MAX_CONCURRENT_RUNS=8
# OPENARTIFACT_MAX_SSE_SUBSCRIBERS=50
# Opt-out only: allow inline scripts in the Content-Security-Policy. Leave off.
# OPENARTIFACT_CSP_SCRIPT_UNSAFE_INLINE=false
# Read by uvicorn: addresses of a reverse proxy whose X-Forwarded-* headers are trusted.
# FORWARDED_ALLOW_IPS=

# ── Docker Compose only (read for the compose file, not by the application) ──
# Address and port the container is published on. 127.0.0.1 keeps it local; 0.0.0.0 opens it to the network.
OPENARTIFACT_BIND=127.0.0.1
OPENARTIFACT_PUBLISHED_PORT=2909
# Image tag when you pull a released image instead of building (docker compose pull).
OPENARTIFACT_TAG=latest
