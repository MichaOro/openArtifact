# .env.example — OpenArtifact Docker Configuration
#
# Copy to deploy/.env (next to docker-compose.yml) and adjust the values.
# All variables use the OPENARTIFACT_ prefix.

# ── Server ──────────────────────────────────────────────────────────
# Bind address INSIDE the container. Keep 0.0.0.0 here: the published address is OPENARTIFACT_BIND below.
# Do not copy this value into a .env of a local (non-Docker) run: there use 127.0.0.1.
OPENARTIFACT_HOST=0.0.0.0
OPENARTIFACT_PORT=2909
OPENARTIFACT_DEBUG=false

# ── Database ────────────────────────────────────────────────────────
# Database filename (default: openartifact.db)
OPENARTIFACT_DATABASE_FILENAME=openartifact.db
# Data directory (default: /data — mounted as Docker volume)
OPENARTIFACT_DATA_DIR=/data

# ── Security ────────────────────────────────────────────────────────
# Required as soon as OPENARTIFACT_API_TOKEN is set or credentials are stored: at least 32 characters; the
# application refuses to start with an empty, default or shorter key. Generate one with:  openssl rand -hex 32
# It signs the session cookie AND encrypts stored credentials: NEVER change it afterwards, or every stored
# credential becomes unreadable. Keep it together with your backups of the database.
OPENARTIFACT_SECRET_KEY=

# ── Logging ─────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR or CRITICAL
OPENARTIFACT_LOG_LEVEL=INFO

# Access token, at least 32 characters (the application refuses to start with a shorter one). With a
# token the whole application asks for it (sign-in page for browsers, bearer header for scripts,
# /api/v1 and /mcp). Empty: the pages and the browser API are open to everyone who can reach the port
# and /api/v1 and /mcp are off. Code nodes do not run in that open mode (see the next section).
# Code nodes and credentials need a token. Rotating it only signs everybody out.
# Generate one with: openssl rand -hex 32
OPENARTIFACT_API_TOKEN=

# ── Optional security and limits (defaults shown; see docs/guides/configuration.md) ──
# Host names the application answers to, comma separated (example.com, *.example.org). Empty: no check.
# OPENARTIFACT_ALLOWED_HOSTS=
# auto: the session cookie is Secure when the request is https; true: always (right behind a TLS proxy); false: never.
# OPENARTIFACT_COOKIE_SECURE=auto
# Largest request body in bytes.
# OPENARTIFACT_MAX_REQUEST_BYTES=1048576
# Active runs at the same time (a further start gets 429) and open live-update streams (a further one gets 503).
# OPENARTIFACT_MAX_CONCURRENT_RUNS=8
# OPENARTIFACT_MAX_SSE_SUBSCRIBERS=50
# Opt-out only: allow inline scripts in the Content-Security-Policy. Leave off.
# OPENARTIFACT_CSP_SCRIPT_UNSAFE_INLINE=false
# ── Execution history ───────────────────────────────────────────────
# Executions kept per artifact without a policy of its own (the oldest finished ones are deleted); 0 keeps all
# of them and lets the database grow.
# OPENARTIFACT_EXECUTION_HISTORY_DEFAULT_KEEP=50

# ── Code and HTTP nodes (see docs/guides/execution-nodes.md; Code is no sandbox) ──
# Whether Code nodes run at all.
# OPENARTIFACT_CODE_NODES_ENABLED=true
# Code nodes without an API token are refused by default: everyone who reaches the port could otherwise run
# commands as the application's user. Allow them only for local development on a machine you trust.
# OPENARTIFACT_CODE_NODES_WITHOUT_TOKEN=false
# Limits of one Code process: output per stream (bytes), address space (MiB, keep it clearly below the
# container's mem_limit of 1g), added processes, largest file (MiB), open files.
# OPENARTIFACT_CODE_OUTPUT_LIMIT_BYTES=65536
# OPENARTIFACT_CODE_MEMORY_LIMIT_MB=512
# OPENARTIFACT_CODE_PROCESS_LIMIT=64
# OPENARTIFACT_CODE_FILE_SIZE_LIMIT_MB=64
# OPENARTIFACT_CODE_OPEN_FILES_LIMIT=256
# Largest response body an HTTP node reads (bytes), and whether HTTP nodes may call loopback/private addresses.
# OPENARTIFACT_HTTP_RESPONSE_LIMIT_BYTES=1048576
# OPENARTIFACT_HTTP_ALLOW_PRIVATE_NETWORKS=false
# Whether the tools of an agent (MCP, HTTP request, Postgres) may be on a loopback/private address; a tool must
# also have its own "private network" switch on. LLM providers need no setting. Does not open HTTP nodes.
# OPENARTIFACT_LLM_ALLOW_PRIVATE_NETWORKS=false

# Read by uvicorn: addresses of a reverse proxy whose X-Forwarded-* headers are trusted.
# FORWARDED_ALLOW_IPS=

# ── Docker Compose only (read for the compose file, not by the application) ──
# Address and port the container is published on. 127.0.0.1 keeps it local (use an SSH port forward or a TLS proxy
# to reach it); 0.0.0.0 opens it to the network: set a token first.
OPENARTIFACT_BIND=127.0.0.1
OPENARTIFACT_PUBLISHED_PORT=2909
# Image tag when you pull a released image instead of building (docker compose pull).
OPENARTIFACT_TAG=latest
