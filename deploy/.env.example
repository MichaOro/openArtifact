# .env.example — OpenArtifact Docker Configuration
#
# Copy to .env and adjust values as needed.
# All variables use the OPENARTIFACT_ prefix.

# ── Server ──────────────────────────────────────────────────────────
OPENARTIFACT_HOST=0.0.0.0
OPENARTIFACT_PORT=2909
OPENARTIFACT_DEBUG=false

# ── Database ────────────────────────────────────────────────────────
# Database filename (default: openartifact.db)
OPENARTIFACT_DATABASE_FILENAME=openartifact.db
# Data directory (default: /data — mounted as Docker volume)
OPENARTIFACT_DATA_DIR=/data

# ── Security ────────────────────────────────────────────────────────
# Change this to a random secret key in production!
OPENARTIFACT_SECRET_KEY=change-me-in-production

# ── Logging ─────────────────────────────────────────────────────────
OPENARTIFACT_LOG_LEVEL=INFO
